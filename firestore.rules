rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================

    // Kiểm tra user đã xác thực chưa
    function isAuthenticated() {
      return request.auth != null;
    }

    // Đọc role từ document /users/{uid} và so sánh lowercase
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole().lower() == 'admin';
    }

    function isEmployee() {
      return isAuthenticated() && getUserRole().lower() == 'employee';
    }

    // Kiểm tra tài khoản có đang hoạt động không
    function isActive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    // =========================================================================
    // Collection: users
    // - Ai cũng có thể đọc bảng users (để lấy tên NV tạo đơn, v.v.)
    // - Admin có toàn quyền thao tác (Create, Delete, Update)
    // - Employee chỉ được phép Update vào doc của chính mình (chặn đổi role)
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated() && isActive();
      
      allow create, delete: if isAdmin() && isActive();
      
      allow update: if isActive() && (
        isAdmin() || 
        (request.auth.uid == userId && request.resource.data.role == resource.data.role)
      );
    }

    // =========================================================================
    // Collection: products
    // - Admin: Toàn quyền (thêm/sửa/xóa/đọc)
    // - Employee: Đọc và Cập nhật (để trừ tồn kho khi bán hàng)
    // =========================================================================
    match /products/{productId} {
      allow read: if isAuthenticated() && isActive();
      
      // Admin có toàn quyền tạo mới và xóa
      allow create, delete: if isAdmin() && isActive();
      
      // Cho phép cả Admin và Employee cập nhật sản phẩm (để thay đổi số lượng stock)
      allow update: if isAuthenticated() && isActive();
    }

    // =========================================================================
    // Collection: orders
    // - Admin: Toàn quyền
    // - Employee: Đọc và tạo đơn hàng mới, cập nhật trạng thái
    //   (không được xóa vĩnh viễn)
    // =========================================================================
    match /orders/{orderId} {
      allow read: if isAuthenticated() && isActive();
      allow create: if isAuthenticated() && isActive();
      allow update: if isAuthenticated() && isActive();
      allow delete: if isAdmin() && isActive(); // Chỉ Admin mới được xóa
    }
  }
}
